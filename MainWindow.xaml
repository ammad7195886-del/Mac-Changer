<Window x:Class="SimpleMACChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple MAC Changer"
        Width="620"
        Height="620"
        MinWidth="620"
        MinHeight="620"
        MaxWidth="620"
        MaxHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ========================= -->
        <!-- COLORS -->
        <!-- ========================= -->

        <SolidColorBrush x:Key="WindowBg" Color="#070D19"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#08101F"/>
        <SolidColorBrush x:Key="CardBg" Color="#0B1424"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1E304C"/>

        <SolidColorBrush x:Key="WhiteText" Color="#F4F7FF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8EA1C2"/>

        <SolidColorBrush x:Key="Blue" Color="#2875F5"/>
        <SolidColorBrush x:Key="BlueHover" Color="#3982FF"/>

        <SolidColorBrush x:Key="Green" Color="#20A05A"/>
        <SolidColorBrush x:Key="GreenHover" Color="#2BBE6C"/>

        <SolidColorBrush x:Key="Red" Color="#D92D3F"/>
        <SolidColorBrush x:Key="RedHover" Color="#EC3B4E"/>

        <SolidColorBrush x:Key="Purple" Color="#9B5CFF"/>


        <!-- ========================= -->
        <!-- ACTION BUTTON -->
        <!-- ========================= -->

        <Style x:Key="ActionButton"
               TargetType="{x:Type Button}">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="13">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================= -->
        <!-- TITLE BAR BUTTON -->
        <!-- ========================= -->

        <Style x:Key="TitleButton"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="42"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#EAF0FF"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="TitleBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TitleBackground"
                                        Property="Background"
                                        Value="#17243B"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="TitleBackground"
                                        Property="Background"
                                        Value="#223451"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================= -->
        <!-- COPY BUTTON -->
        <!-- ========================= -->

        <Style x:Key="CopyButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#111C31"/>

            <Setter Property="Foreground"
                    Value="#9B5CFF"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CopyBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,10,10,0">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CopyBackground"
                                        Property="Background"
                                        Value="#1A2944"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ================================= -->
    <!-- OUTER WINDOW -->
    <!-- ================================= -->

    <Border Margin="4"
            CornerRadius="17"
            Background="{StaticResource WindowBg}"
            BorderBrush="#263E6B"
            BorderThickness="1">

        <Grid>


            <!-- ================================= -->
            <!-- ROWS -->
            <!-- ================================= -->

            <Grid.RowDefinitions>

                <RowDefinition Height="82"/>

                <RowDefinition Height="1"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================= -->
            <!-- HEADER -->
            <!-- ================================= -->

            <Grid Grid.Row="0"
                  Background="{StaticResource HeaderBg}"
                  MouseLeftButtonDown="TitleBar_MouseDown">


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="75"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="130"/>

                </Grid.ColumnDefinitions>


                <!-- WIFI LOGO -->

                <Border Grid.Column="0"
                        Width="52"
                        Height="52"
                        CornerRadius="14"
                        Background="#315FEA"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Grid>

                        <Path
                            Data="M 8,22
                                  C 20,10 40,10 52,22
                                  M 15,30
                                  C 24,22 36,22 45,30
                                  M 23,38
                                  C 27,34 33,34 37,38"
                            Stroke="White"
                            StrokeThickness="4.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Width="35"
                            Height="35"/>

                        <Ellipse
                            Width="5"
                            Height="5"
                            Fill="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,9"/>

                    </Grid>

                </Border>


                <!-- TITLE -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="Simple MAC Changer"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource WhiteText}"/>

                    <TextBlock
                        Text="Change your Wi-Fi MAC address easily"
                        FontSize="11"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource SecondaryText}"/>

                </StackPanel>


                <!-- WINDOW CONTROLS -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,7,7,0">

                    <Button
                        Style="{StaticResource TitleButton}"
                        Click="Minimize_Click">

                        <TextBlock
                            Text="—"
                            FontSize="18"
                            Margin="0,-5,0,0"/>

                    </Button>

                    <Button
                        Style="{StaticResource TitleButton}"
                        Click="Maximize_Click">

                        <TextBlock
                            Text="□"
                            FontSize="16"/>

                    </Button>

                    <Button
                        Style="{StaticResource TitleButton}"
                        Click="Close_Click">

                        <TextBlock
                            Text="×"
                            FontSize="26"
                            Margin="0,-3,0,0"/>

                    </Button>

                </StackPanel>

            </Grid>


            <!-- HEADER LINE -->

            <Border Grid.Row="1"
                    Background="#1B2C49"/>


            <!-- ================================= -->
            <!-- EVERYTHING BELOW HEADER -->
            <!-- ================================= -->

            <Grid Grid.Row="2"
                  Margin="18,16,18,16">

                <Grid.RowDefinitions>

                    <RowDefinition Height="112"/>

                    <RowDefinition Height="238"/>

                    <RowDefinition Height="70"/>

                    <RowDefinition Height="70"/>

                </Grid.RowDefinitions>


                <!-- ================================= -->
                <!-- ACTIVE ADAPTER -->
                <!-- ================================= -->

                <Border Grid.Row="0"
                        CornerRadius="14"
                        Background="#101D35"
                        BorderBrush="#294A83"
                        BorderThickness="1">

                    <Grid Margin="15">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="78"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="100"/>

                        </Grid.ColumnDefinitions>


                        <!-- WIFI CIRCLE -->

                        <Border
                            Grid.Column="0"
                            Width="62"
                            Height="62"
                            CornerRadius="31"
                            Background="#2875F5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Grid>

                                <Path
                                    Data="M 7,25
                                          C 18,14 38,14 49,25
                                          M 14,33
                                          C 23,25 33,25 42,33
                                          M 22,41
                                          C 26,37 30,37 34,41"
                                    Stroke="White"
                                    StrokeThickness="4"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    Stretch="Uniform"
                                    Width="38"
                                    Height="38"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Ellipse
                                    Width="5"
                                    Height="5"
                                    Fill="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,13"/>

                            </Grid>

                        </Border>


                        <!-- ADAPTER TEXT -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,8,0">

                            <TextBlock
                                Text="ACTIVE ADAPTER"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#3583FF"/>

                            <TextBlock
                                x:Name="AdapterText"
                                Text="Wi-Fi - Network Adapter"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource WhiteText}"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,6,0,0"/>

                            <TextBlock
                                Text="Network Adapter"
                                FontSize="10"
                                Foreground="{StaticResource SecondaryText}"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <!-- STATUS -->

                        <Border Grid.Column="2"
                                Width="92"
                                Height="34"
                                CornerRadius="17"
                                Background="#083624"
                                BorderBrush="#14583D"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="#64E8AE"
                                    Margin="0,0,7,0"/>

                                <TextBlock
                                    x:Name="StatusText"
                                    Text="CONNECTED"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="#64E8AE"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- MAC INFORMATION -->
                <!-- ================================= -->

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        CornerRadius="14"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1">

                    <Grid Margin="15,7">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="72"/>

                            <RowDefinition Height="72"/>

                            <RowDefinition Height="72"/>

                        </Grid.RowDefinitions>


                        <!-- OLD MAC -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="210"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Old MAC Address"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WhiteText}"/>

                                <TextBlock
                                    Text="Original adapter address"
                                    FontSize="9"
                                    Foreground="{StaticResource SecondaryText}"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Height="44"
                                CornerRadius="10"
                                Background="#0D1728"
                                BorderBrush="#1D2C43"
                                BorderThickness="1">

                                <TextBlock
                                    x:Name="OldMacText"
                                    Text="00-E0-38-8F-DC-C6"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WhiteText}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <!-- DIVIDER -->

                        <Border Grid.Row="0"
                                Height="1"
                                Background="#1C2B42"
                                VerticalAlignment="Bottom"/>


                        <!-- CURRENT MAC -->

                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="210"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Current MAC Address"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WhiteText}"/>

                                <TextBlock
                                    Text="Address currently in use"
                                    FontSize="9"
                                    Foreground="{StaticResource SecondaryText}"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Height="44"
                                CornerRadius="10"
                                Background="#0D1728"
                                BorderBrush="#1D2C43"
                                BorderThickness="1">

                                <TextBlock
                                    x:Name="CurrentMacText"
                                    Text="00-E0-38-8F-DC-C6"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WhiteText}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <!-- DIVIDER -->

                        <Border Grid.Row="1"
                                Height="1"
                                Background="#1C2B42"
                                VerticalAlignment="Bottom"/>


                        <!-- NEW MAC -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="210"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="New MAC Address"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource WhiteText}"/>

                                <TextBlock
                                    Text="Generated MAC address"
                                    FontSize="9"
                                    Foreground="{StaticResource SecondaryText}"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <!-- NEW MAC BOX -->

                            <Border
                                Grid.Column="1"
                                Height="44"
                                CornerRadius="10"
                                Background="#0D1728"
                                BorderBrush="#293C5B"
                                BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="45"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                        x:Name="NewMacText"
                                        Text="Not generated yet"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#8798B5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>


                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource CopyButton}"
                                        Click="Copy_Click">

                                        <TextBlock
                                            Text="▣"
                                            FontSize="20"
                                            Foreground="#9B5CFF"/>

                                    </Button>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- GENERATE + RESTORE -->
                <!-- ================================= -->

                <Grid Grid.Row="2"
                      Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="12"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- GENERATE -->

                    <Button
                        Grid.Column="0"
                        Style="{StaticResource ActionButton}"
                        Background="{StaticResource Blue}"
                        Click="Generate_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <TextBlock
                                Text="✦"
                                FontSize="19"
                                Margin="0,0,10,0"/>

                            <StackPanel>

                                <TextBlock
                                    Text="Generate New MAC"
                                    FontSize="14"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="Generate &amp; apply"
                                    FontSize="9"
                                    Margin="0,3,0,0"
                                    Opacity="0.8"/>

                            </StackPanel>

                        </StackPanel>

                    </Button>


                    <!-- RESTORE -->

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource ActionButton}"
                        Background="{StaticResource Green}"
                        Click="Restore_Click">

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <TextBlock
                                Text="↻"
                                FontSize="22"
                                Margin="0,0,10,0"/>

                            <StackPanel>

                                <TextBlock
                                    Text="Restore MAC"
                                    FontSize="14"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="Restore original"
                                    FontSize="9"
                                    Margin="0,3,0,0"
                                    Opacity="0.8"/>

                            </StackPanel>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================= -->
                <!-- QUIT -->
                <!-- ================================= -->

                <Button
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Style="{StaticResource ActionButton}"
                    Background="{StaticResource Red}"
                    Click="Close_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="⏻"
                            FontSize="22"
                            Margin="0,0,10,0"/>

                        <StackPanel>

                            <TextBlock
                                Text="Quit"
                                FontSize="14"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Close the application"
                                FontSize="9"
                                Margin="0,3,0,0"
                                Opacity="0.8"/>

                        </StackPanel>

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>
