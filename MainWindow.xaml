<Window x:Class="SimpleMACChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple MAC Changer"
        Width="460"
        Height="570"
        MinWidth="460"
        MinHeight="570"
        MaxWidth="460"
        MaxHeight="570"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">

    <Window.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="WindowBackground" Color="#070D1A"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#091222"/>
        <SolidColorBrush x:Key="CardBackground" Color="#0D1627"/>
        <SolidColorBrush x:Key="CardBorder" Color="#263A5C"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#246BEB"/>
        <SolidColorBrush x:Key="PrimaryBlue2" Color="#1747C5"/>
        <SolidColorBrush x:Key="Green" Color="#17964F"/>
        <SolidColorBrush x:Key="Red" Color="#D9283A"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F4F7FF"/>
        <SolidColorBrush x:Key="TextGray" Color="#8D9BB5"/>
        <SolidColorBrush x:Key="Purple" Color="#914EFF"/>
        <SolidColorBrush x:Key="GreenText" Color="#63E8AE"/>

        <!-- Main button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#172337"/>
            <Setter Property="Foreground" Value="#9D62FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

    </Window.Resources>

    <!-- Outer rounded window -->
    <Border CornerRadius="18"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#31518A"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->

            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackground}"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">

                <Grid Margin="18,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="105"/>
                    </Grid.ColumnDefinitions>

                    <!-- Wi-Fi logo -->
                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="13"
                            Background="#2B5BE9"
                            VerticalAlignment="Center">

                        <Viewbox Margin="9">
                            <Canvas Width="32" Height="32">

                                <Path Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 3,12 Q 16,0 29,12"/>

                                <Path Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 8,18 Q 16,10 24,18"/>

                                <Ellipse Fill="White"
                                         Width="5"
                                         Height="5"
                                         Canvas.Left="13.5"
                                         Canvas.Top="22"/>

                            </Canvas>
                        </Viewbox>

                    </Border>

                    <!-- Title -->
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Simple MAC Changer"
                                   FontFamily="Segoe UI"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextWhite}"/>

                        <TextBlock Text="Change your Wi-Fi MAC address easily"
                                   Margin="0,3,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="{StaticResource TextGray}"/>

                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="17"
                                Content="─"
                                Click="Minimize_Click"
                                Cursor="Hand"/>

                        <Button Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="15"
                                Content="□"
                                Click="Maximize_Click"
                                Cursor="Hand"/>

                        <Button Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="19"
                                Content="×"
                                Click="Close_Click"
                                Cursor="Hand"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================= CONTENT ================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="18,18,18,18">

                    <!-- ACTIVE ADAPTER CARD -->

                    <Border Height="132"
                            CornerRadius="15"
                            Background="#101D35"
                            BorderBrush="#304F88"
                            BorderThickness="1"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- WiFi circle -->
                            <Border Grid.Column="0"
                                    Width="62"
                                    Height="62"
                                    CornerRadius="31"
                                    Background="#2167E9"
                                    VerticalAlignment="Center">

                                <Viewbox Margin="13">
                                    <Canvas Width="32" Height="32">

                                        <Path Stroke="White"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 3,12 Q 16,0 29,12"/>

                                        <Path Stroke="White"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 8,18 Q 16,10 24,18"/>

                                        <Ellipse Fill="White"
                                                 Width="5"
                                                 Height="5"
                                                 Canvas.Left="13.5"
                                                 Canvas.Top="22"/>

                                    </Canvas>
                                </Viewbox>

                            </Border>

                            <!-- Adapter information -->
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="ACTIVE ADAPTER"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#3D8BFF"/>

                                <TextBlock x:Name="AdapterNameText"
                                           Text="Detecting Wi-Fi adapter..."
                                           Margin="0,7,0,0"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextWhite}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="Network Adapter"
                                           Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource TextGray}"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- MAC CARD -->

                    <Border Margin="0,12,0,0"
                            CornerRadius="15"
                            Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            Padding="14">

                        <StackPanel>

                            <!-- OLD MAC -->

                            <Grid Height="70">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Old MAC Address"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextWhite}"/>

                                    <TextBlock Text="Original adapter address"
                                               Margin="0,5,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource TextGray}"/>

                                </StackPanel>

                                <Border Grid.Column="1"
                                        Height="46"
                                        CornerRadius="10"
                                        Background="#0B1422"
                                        BorderBrush="#1E2D45"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="OldMacText"
                                               Text="--"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextWhite}"/>

                                </Border>

                            </Grid>

                            <Border Height="1"
                                    Background="#223149"/>


                            <!-- CURRENT MAC -->

                            <Grid Height="70">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Current MAC Address"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextWhite}"/>

                                    <TextBlock Text="Address currently in use"
                                               Margin="0,5,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource TextGray}"/>

                                </StackPanel>

                                <Border Grid.Column="1"
                                        Height="46"
                                        CornerRadius="10"
                                        Background="#0B1422"
                                        BorderBrush="#1E2D45"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="CurrentMacText"
                                               Text="--"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextWhite}"/>

                                </Border>

                            </Grid>

                            <Border Height="1"
                                    Background="#223149"/>


                            <!-- NEW MAC -->

                            <Grid Height="70">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="New MAC Address"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextWhite}"/>

                                    <TextBlock Text="Generated MAC address"
                                               Margin="0,5,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource TextGray}"/>

                                </StackPanel>

                                <Border Grid.Column="1"
                                        Height="46"
                                        CornerRadius="10"
                                        Background="#0B1422"
                                        BorderBrush="#263A5C"
                                        BorderThickness="1">

                                    <Grid>

                                        <TextBlock x:Name="NewMacText"
                                                   Text="Not generated yet"
                                                   Margin="12,0,42,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextGray}"/>

                                        <Button x:Name="CopyButton"
                                                Width="40"
                                                Height="44"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource IconButton}"
                                                Content="▣"
                                                Click="Copy_Click"
                                                ToolTip="Copy MAC address"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ACTION BUTTONS -->

                    <Grid Margin="0,12,0,0"
                          Height="82">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- Generate -->

                        <Button Grid.Column="0"
                                Style="{StaticResource ActionButton}"
                                Click="Generate_Click">

                            <Border CornerRadius="13"
                                    Background="{StaticResource PrimaryBlue}">

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="✦  Generate New MAC"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="Generate &amp; apply"
                                               FontSize="9"
                                               Margin="0,5,0,0"
                                               Foreground="#D9E6FF"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </Button>


                        <!-- Restore -->

                        <Button Grid.Column="2"
                                Style="{StaticResource ActionButton}"
                                Click="Restore_Click">

                            <Border CornerRadius="13"
                                    Background="{StaticResource Green}">

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="↻  Restore MAC"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="Restore original"
                                               FontSize="9"
                                               Margin="0,5,0,0"
                                               Foreground="#D5FFE9"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </Button>

                    </Grid>


                    <!-- STATUS -->

                    <TextBlock x:Name="StatusText"
                               Text="●  CONNECTED"
                               Margin="0,9,0,0"
                               HorizontalAlignment="Center"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource GreenText}"/>


                    <!-- QUIT -->

                    <Button Height="55"
                            Margin="0,8,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="Close_Click">

                        <Border CornerRadius="12"
                                Background="{StaticResource Red}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="⏻"
                                           FontSize="21"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <StackPanel>

                                    <TextBlock Text="Quit"
                                               FontSize="13"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Close the application"
                                               FontSize="9"
                                               Margin="0,2,0,0"
                                               Foreground="#FFE1E4"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </Button>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>
