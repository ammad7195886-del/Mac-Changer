<Window x:Class="SimpleMACChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple MAC Changer"
        Width="760"
        Height="570"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1020"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#11182A"/>
        <SolidColorBrush x:Key="CardBackground" Color="#151E32"/>
        <SolidColorBrush x:Key="CardBorder" Color="#25304A"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#4B7BFF"/>
        <SolidColorBrush x:Key="PrimaryBlueDark" Color="#315FD9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8D9AB5"/>
        <SolidColorBrush x:Key="Green" Color="#65E8AE"/>
        <SolidColorBrush x:Key="Red" Color="#FF647C"/>

        <!-- SHADOW -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="28"
                          ShadowDepth="0"
                          Opacity="0.45"
                          Color="#000000"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.25"
                          Color="#000000"/>

        <!-- ROUNDED BUTTON -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.70"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <!-- OUTER WINDOW -->
    <Border Margin="12"
            Background="{StaticResource WindowBackground}"
            CornerRadius="18"
            Effect="{StaticResource WindowShadow}"
            BorderBrush="#202A43"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>


            <!-- ========================= -->
            <!-- TITLE BAR -->
            <!-- ========================= -->

            <Border Grid.Row="0"
                    Background="#0D1425"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>


                    <!-- LOGO + TITLE -->

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- WIFI ICON -->

                        <Border Width="40"
                                Height="40"
                                CornerRadius="11"
                                Background="#18264B"
                                Margin="0,0,13,0">

                            <Grid>

                                <!-- Wi-Fi arcs -->

                                <Path Stroke="#5E8BFF"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 9,16 Q 20,6 31,16"/>

                                <Path Stroke="#5E8BFF"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 13,21 Q 20,15 27,21"/>

                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="#5E8BFF"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,7"/>

                            </Grid>
                        </Border>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Simple MAC Changer"
                                       FontFamily="Segoe UI"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>

                            <TextBlock Text="Network identity utility"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- MINIMIZE -->

                    <Button Grid.Column="1"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#77849E"
                            FontSize="18"
                            Content="−"
                            Click="Minimize_Click"/>


                    <!-- MAXIMIZE -->

                    <Button Grid.Column="2"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#77849E"
                            FontSize="14"
                            Content="□"
                            Click="Maximize_Click"/>


                    <!-- CLOSE -->

                    <Button Grid.Column="3"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#77849E"
                            FontSize="15"
                            Content="✕"
                            Click="Close_Click"/>

                </Grid>

            </Border>


            <!-- ========================= -->
            <!-- MAIN CONTENT -->
            <!-- ========================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="30,25,30,25">


                    <!-- HEADER -->

                    <TextBlock Text="MAC Address"
                               FontFamily="Segoe UI"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>

                    <TextBlock Text="Generate and preview a new locally administered MAC address."
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,6,0,22"/>


                    <!-- ADAPTER CARD -->

                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="ACTIVE ADAPTER"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="Wi-Fi"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,5,0,2"/>

                                <TextBlock Text="Wireless network adapter"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>

                            </StackPanel>


                            <!-- CONNECTED BADGE -->

                            <Border Grid.Column="1"
                                    Background="#142D26"
                                    CornerRadius="20"
                                    Padding="13,7"
                                    VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{StaticResource Green}"
                                             Margin="0,0,7,0"/>

                                    <TextBlock Text="CONNECTED"
                                               FontFamily="Segoe UI"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Green}"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- SPACING -->

                    <Rectangle Height="14"
                               Fill="Transparent"/>


                    <!-- MAC GRID -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- OLD MAC -->

                        <Border Grid.Column="0"
                                Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="ORIGINAL MAC"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="00-E0-38-8F-DC-C6"
                                           FontFamily="Consolas"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,12,0,3"/>

                                <TextBlock Text="Hardware address"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>

                            </StackPanel>

                        </Border>


                        <!-- CURRENT MAC -->

                        <Border Grid.Column="2"
                                Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="CURRENT MAC"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock x:Name="CurrentMacText"
                                           Text="00-E0-38-8F-DC-C6"
                                           FontFamily="Consolas"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,12,0,3"/>

                                <TextBlock x:Name="StatusText"
                                           Text="●  CONNECTED"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Green}"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- SPACING -->

                    <Rectangle Height="14"
                               Fill="Transparent"/>


                    <!-- NEW MAC CARD -->

                    <Border Background="#121C31"
                            BorderBrush="#2C3C63"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="NEW MAC ADDRESS"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#7F9DEB"/>

                                <TextBlock x:Name="NewMacText"
                                           Text="Not generated yet"
                                           FontFamily="Consolas"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,9,0,0"/>

                            </StackPanel>


                            <!-- COPY -->

                            <Button Grid.Column="1"
                                    Width="82"
                                    Height="38"
                                    Content="Copy"
                                    Background="#1C2945"
                                    Foreground="#B9C8EA"
                                    Style="{StaticResource RoundedButton}"
                                    Click="Copy_Click"/>

                        </Grid>

                    </Border>


                    <!-- SPACING -->

                    <Rectangle Height="18"
                               Fill="Transparent"/>


                    <!-- ACTION BUTTONS -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- GENERATE -->

                        <Button Grid.Column="0"
                                Height="48"
                                Content="✦   Generate New MAC"
                                Background="{StaticResource PrimaryBlue}"
                                Effect="{StaticResource ButtonShadow}"
                                Style="{StaticResource RoundedButton}"
                                Click="Generate_Click"/>


                        <!-- RESTORE -->

                        <Button Grid.Column="2"
                                Height="48"
                                Content="↻   Restore MAC"
                                Background="#1B273F"
                                Foreground="#D9E2F7"
                                BorderBrush="#2B3A58"
                                Style="{StaticResource RoundedButton}"
                                Click="Restore_Click"/>

                    </Grid>

                </StackPanel>

            </ScrollViewer>


            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->

            <Border Grid.Row="2"
                    Background="#0D1425"
                    CornerRadius="0,0,18,18"
                    BorderBrush="#202A43"
                    BorderThickness="0,1,0,0">

                <Grid Margin="30,0">

                    <TextBlock Text="Simple MAC Changer"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>


                    <Button HorizontalAlignment="Right"
                            Width="90"
                            Height="36"
                            Content="Quit"
                            Background="#321D27"
                            Foreground="#FF7E91"
                            Style="{StaticResource RoundedButton}"
                            Click="Close_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>