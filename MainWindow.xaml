<Window x:Class="SimpleMACChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple MAC Changer"
        Width="780"
        Height="720"
        MinWidth="780"
        MinHeight="720"
        MaxWidth="780"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#070D1B">

    <Window.Resources>

        <!-- COLORS -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#070D1B"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#0C1526"/>

        <SolidColorBrush x:Key="PanelBorderBrush"
                         Color="#1B2A45"/>

        <SolidColorBrush x:Key="BlueBrush"
                         Color="#246BFF"/>

        <SolidColorBrush x:Key="GreenBrush"
                         Color="#20A45A"/>

        <SolidColorBrush x:Key="RedBrush"
                         Color="#D9283F"/>

        <SolidColorBrush x:Key="WhiteBrush"
                         Color="#F5F7FC"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#8795B0"/>

        <SolidColorBrush x:Key="InputBrush"
                         Color="#0A1322"/>


        <!-- MAIN BUTTON -->

        <Style x:Key="MainButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.86"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- TITLE BAR BUTTON -->

        <Style x:Key="TitleButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Width"
                    Value="42"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="TitleBorder"
                                Background="Transparent"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TitleBorder"
                                        Property="Background"
                                        Value="#18233A"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- WINDOW -->
    <!-- ========================================================= -->

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="#263C65"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="100"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="#080F20"
                    BorderBrush="#1B2A45"
                    BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="88"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="135"/>

                    </Grid.ColumnDefinitions>


                    <!-- WIFI ICON -->

                    <Border Grid.Column="0"
                            Width="58"
                            Height="58"
                            Margin="22,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            CornerRadius="15"
                            Background="#2464E8">

                        <Viewbox Width="36"
                                 Height="36"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">

                            <Canvas Width="40"
                                    Height="40">

                                <Path
                                    Fill="White"
                                    Data="M 2,13 C 12,3 28,3 38,13 L 34,17 C 26,9 14,9 6,17 Z
                                          M 8,21 C 15,14 25,14 32,21 L 28,25 C 23,20 17,20 12,25 Z
                                          M 15,29 C 18,26 22,26 25,29 L 20,34 Z"/>

                            </Canvas>

                        </Viewbox>

                    </Border>


                    <!-- TITLE -->

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Simple MAC Changer"
                                   FontFamily="Segoe UI"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WhiteBrush}"/>

                        <TextBlock Text="Manage your Wi-Fi adapter"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- WINDOW BUTTONS -->

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">

                        <Button Style="{StaticResource TitleButton}"
                                Click="Minimize_Click">

                            <TextBlock Text="—"
                                       FontSize="19"
                                       Foreground="White"/>

                        </Button>


                        <Button Style="{StaticResource TitleButton}"
                                Click="Maximize_Click">

                            <Border Width="12"
                                    Height="12"
                                    BorderBrush="White"
                                    BorderThickness="1.5"/>

                        </Button>


                        <Button Style="{StaticResource TitleButton}"
                                Click="Close_Click">

                            <Grid Width="17"
                                  Height="17">

                                <Path Stroke="White"
                                      StrokeThickness="2"
                                      Data="M 2,2 L 15,15"/>

                                <Path Stroke="White"
                                      StrokeThickness="2"
                                      Data="M 15,2 L 2,15"/>

                            </Grid>

                        </Button>

                    </StackPanel>


                    <!-- DRAG AREA -->

                    <Border Grid.ColumnSpan="2"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseDown"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN CONTENT -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  Margin="22,18,22,18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="120"/>

                    <RowDefinition Height="220"/>

                    <RowDefinition Height="72"/>

                    <RowDefinition Height="62"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- ADAPTER -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="#101D37"
                        BorderBrush="#294A87"
                        BorderThickness="1"
                        CornerRadius="18">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="72"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="120"/>

                        </Grid.ColumnDefinitions>


                        <!-- WIFI ICON -->

                        <Border Grid.Column="0"
                                Width="58"
                                Height="58"
                                CornerRadius="29"
                                Background="#246BEF"
                                VerticalAlignment="Center">

                            <Viewbox Width="34"
                                     Height="34"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">

                                <Canvas Width="40"
                                        Height="40">

                                    <Path
                                        Fill="White"
                                        Data="M 2,13 C 12,3 28,3 38,13 L 34,17 C 26,9 14,9 6,17 Z
                                              M 8,21 C 15,14 25,14 32,21 L 28,25 C 23,20 17,20 12,25 Z
                                              M 15,29 C 18,26 22,26 25,29 L 20,34 Z"/>

                                </Canvas>

                            </Viewbox>

                        </Border>


                        <!-- ADAPTER TEXT -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="14,0,10,0">

                            <TextBlock Text="ACTIVE ADAPTER"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#4D8EFF"/>

                            <TextBlock x:Name="AdapterNameText"
                                       Text="Detecting Wi-Fi..."
                                       FontFamily="Segoe UI"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WhiteBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,0"/>

                            <TextBlock Text="Windows network adapter"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- STATUS -->

                        <Border Grid.Column="2"
                                Width="112"
                                Height="38"
                                CornerRadius="19"
                                Background="#092E24"
                                BorderBrush="#155A44"
                                BorderThickness="1"
                                VerticalAlignment="Center">

                            <TextBlock x:Name="StatusText"
                                       Text="●  CONNECTED"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#65E8AE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- MAC INFORMATION -->
                <!-- ================================================= -->

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Background="#0A1322"
                        BorderBrush="#1B2A45"
                        BorderThickness="1"
                        CornerRadius="18">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="60"/>

                            <RowDefinition Height="1"/>

                            <RowDefinition Height="60"/>

                            <RowDefinition Height="1"/>

                            <RowDefinition Height="60"/>

                        </Grid.RowDefinitions>


                        <!-- OLD -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="260"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Old MAC Address"
                                           FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"/>

                                <TextBlock Text="Original adapter address"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    Height="44"
                                    Background="{StaticResource InputBrush}"
                                    BorderBrush="#1B2A45"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <TextBlock x:Name="OldMacText"
                                           Text="Detecting..."
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WhiteBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <Border Grid.Row="1"
                                Background="#1B2A45"/>


                        <!-- CURRENT -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="260"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Current MAC Address"
                                           FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"/>

                                <TextBlock Text="Address currently displayed"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    Height="44"
                                    Background="{StaticResource InputBrush}"
                                    BorderBrush="#1B2A45"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <TextBlock x:Name="CurrentMacText"
                                           Text="Detecting..."
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WhiteBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <Border Grid.Row="3"
                                Background="#1B2A45"/>


                        <!-- NEW -->

                        <Grid Grid.Row="4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="260"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="New MAC Address"
                                           FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"/>

                                <TextBlock Text="Generated address"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    Height="44"
                                    Background="{StaticResource InputBrush}"
                                    BorderBrush="#354564"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="48"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock x:Name="NewMacText"
                                               Text="Not generated yet"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="#8998B5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                    <Button Grid.Column="1"
                                            Background="#111D33"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="Copy_Click">

                                        <Grid Width="20"
                                              Height="20">

                                            <Border Width="12"
                                                    Height="12"
                                                    BorderBrush="#9A58FF"
                                                    BorderThickness="2"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"/>

                                            <Border Width="12"
                                                    Height="12"
                                                    BorderBrush="#9A58FF"
                                                    BorderThickness="2"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"/>

                                        </Grid>

                                    </Button>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- ACTION BUTTONS -->
                <!-- ================================================= -->

                <Grid Grid.Row="2"
                      Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- GENERATE -->

                    <Button Grid.Column="0"
                            Margin="0,0,6,0"
                            Background="{StaticResource BlueBrush}"
                            Style="{StaticResource MainButton}"
                            Click="Generate_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="✦"
                                       FontSize="24"
                                       Foreground="White"
                                       Margin="0,0,10,0"/>

                            <StackPanel>

                                <TextBlock Text="Generate New MAC"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Generate random address"
                                           FontSize="9"
                                           Foreground="#C9D8FF"
                                           Margin="0,2,0,0"/>

                            </StackPanel>

                        </StackPanel>

                    </Button>


                    <!-- RESTORE -->

                    <Button Grid.Column="1"
                            Margin="6,0,0,0"
                            Background="{StaticResource GreenBrush}"
                            Style="{StaticResource MainButton}"
                            Click="Restore_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="↻"
                                       FontSize="26"
                                       Foreground="White"
                                       Margin="0,0,10,0"/>

                            <StackPanel>

                                <TextBlock Text="Restore MAC"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Restore original address"
                                           FontSize="9"
                                           Foreground="#C8F5DD"
                                           Margin="0,2,0,0"/>

                            </StackPanel>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================================= -->
                <!-- QUIT -->
                <!-- ================================================= -->

                <Button Grid.Row="3"
                        Margin="0,12,0,0"
                        Background="{StaticResource RedBrush}"
                        Style="{StaticResource MainButton}"
                        Click="Close_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="⏻"
                                   FontSize="25"
                                   Foreground="White"
                                   Margin="0,0,10,0"/>

                        <StackPanel>

                            <TextBlock Text="Quit"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Close the application"
                                       FontSize="9"
                                       Foreground="#FFD2D8"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>
